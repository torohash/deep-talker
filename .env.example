# ローカル実行時は、このファイルを .env にコピーして値を設定する。
# 本番ではDBのURLとトークンをCloudflareのSecretに設定する。

# Tursoの開発用DBのHTTPS接続URL（例: https://DATABASE-ORG.turso.io）
# ローカルDBを使う場合は http://127.0.0.1:8080
TURSO_DATABASE_URL=""

# 対象DBの読み書き権限を持つ接続トークン（ローカルDBでは空文字）
TURSO_AUTH_TOKEN=""

# アプリをローカルのHTTPで開く場合はfalse、本番のHTTPSではtrue
COOKIE_SECURE="false"
